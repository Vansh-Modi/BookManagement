﻿@model movieBooking.Models.Movie
@using System.Data
@{
    ViewBag.Title = "Create";
    DataTable movieTable = ViewBag.MovieDataTable as DataTable;
    var sessionMovieId = Session["SelectedMovieID"] != null ? Session["SelectedMovieID"].ToString() : "";
}

<h2>Add Movie Booking</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Movie</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.cd.Movie_ID, "Movie", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select name="cd.Movie_ID" id="movieDropdown" class="form-control">
                    <option value="">-- Select Movie --</option>
                    @if (movieTable != null)
                    {
                        foreach (DataRow row in movieTable.Rows)
                        {
                            var isSelected = row["Movie_ID"].ToString() == sessionMovieId ? "selected='selected'" : "";
                            <option value="@row["Movie_ID"]"
                                    data-catid="@row["Cat_ID"]"
                                    data-cattype="@row["Cat_Type"]"
                                    data-rate="@row["rate"]"
                                    @Html.Raw(isSelected)>
                                @row["Movie_name"]
                            </option>
                        }
                    }
                </select>
                @Html.ValidationMessageFor(model => model.cd.Movie_ID, "", new { @class = "text-danger" })
            </div>
        </div>

        @Html.HiddenFor(model => model.cd.Cat_ID, new { id = "catIdField" })

        <div class="form-group">
            <label class="control-label col-md-2">Category</label>
            <div class="col-md-10">
                <input type="text" id="catTypeField" class="form-control" readonly="readonly" />
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.cd.no_of_Tickets, "No of Tickets", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.cd.no_of_Tickets, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.no_of_Tickets, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.cd.rate, "Rate", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.cd.rate, new { @class = "form-control", id = "rateField", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.cd.rate, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        function updateMovieDetails() {
            var selectedOption = $('#movieDropdown').find(':selected');
            $('#catIdField').val(selectedOption.data('catid') || '');
            $('#catTypeField').val(selectedOption.data('cattype') || '');
            $('#rateField').val(selectedOption.data('rate') || '');
        }

        $(function () {
            // Trigger on page load in case a session pre-selected movie is active
            updateMovieDetails();

            // Trigger when dropdown value changes
            $('#movieDropdown').change(function () {
                updateMovieDetails();
            });
        });
    </script>
}