@model movieBooking.Models.Movie

@{
    ViewBag.Title = "Create";
}

<h2>Add Movie Booking</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Movie</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div form="form-group">
            @Html.LabelFor(model => model.cd.Movie_ID, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.cd.Movie_ID, (SelectList)ViewBag.CategoryList, "-- Select Movie --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.Movie_ID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div form="form-group">
            @Html.LabelFor(model => model.cd.Cat_ID, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.cd.Cat_ID, (SelectList)ViewBag.CategoryList, "-- Select Category --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.Cat_ID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div form="form-group">
            @Html.LabelFor(model => model.cd.no_of_Tickets, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(mode => Model.cd.no_of_Tickets, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.no_of_Tickets, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
