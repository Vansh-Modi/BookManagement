@model movieBooking.Models.Movie
    @using System.Data

@{
    ViewBag.Title = "AddMovie";
}

<h2>Insert Movie</h2>
<p>@Html.ActionLink("Add New Category", "AddCategory")</p>

@using (Html.BeginForm("AddMovie", "Movie", FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(model => model.cd.Cat_ID, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(
           model => model.cd.Cat_ID,
           (SelectList)ViewBag.CategoryList,
           "Select Category",
           new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.Cat_ID, "", new { @class = "text-danger" })
        </div>
    </div>
    <br/>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.Release_Date, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.Release_Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.cd.Release_Date, "", new { @class = "text-danger" })
        </div>
    </div>
    <br/>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.Movie_name, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.Movie_name, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.Movie_name, "", new { @class = "text-danger" })
        </div>
    </div>
        <br/>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.no_of_Tickets, "No of Tickets", new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.cd.no_of_Tickets, new { @class = "form-control", rows = 4 })
            @Html.ValidationMessageFor(model => model.cd.no_of_Tickets, "", new { @class = "text-danger" })
        </div>
    </div>
        <br /><br />
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Create" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}