@model movieBooking.Models.Movie
    @using System.Data

@{
    ViewBag.Title = "AddMovieCategory";
}

<h2>AddMovieCategory</h2>


@using (Html.BeginForm("Create", "Movie", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Add Movie</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.cd.Cat_ID, "Catgegory", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.cd.Cat_ID, new SelectList(((DataTable)ViewBag.CategoryList).DefaultView, "Cat_ID", "Cat_Type"), "Select Category", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.Cat_ID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.cd.Release_Date, new { @class = "form-control col-md-2 control-label" })",type="date"})
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.cd.Release_Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(model => model.cd.Release_Date, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.cd.Movie_name, new { @class = "form-control col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.cd.Movie_name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.cd.Movie_name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.cd.rate, new { @class = "form-control col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.cd.rate, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(model => model.cd.rate, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}