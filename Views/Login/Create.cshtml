@model movieBooking.Models.LoginModel

@{
    ViewBag.Title = "Create";
}

<h2>User Registration</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Movie</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(model => model.cd.User_Name, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.User_Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.User_Name, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.Email_ID, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.Email_ID, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.Email_ID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.User_password, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.User_password, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.User_password, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.City, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.City, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.City, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.cd.Phone, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cd.Phone, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.cd.Phone, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Create" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Alreay a User ? Login.", "Login")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
